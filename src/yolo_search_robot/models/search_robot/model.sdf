<?xml version="1.0"?>
<!--
  Differential-drive "search robot".
  Base structure (two driven wheels + caster + DiffDrive plugin, cmd_vel topic) follows the
  baseline sample "gazeboとROS2を連携してロボットを操作する". Added in this project:
    * front RGB camera  (camera/image_raw)  -> input of the YOLO detector
    * 360 deg 2D LiDAR  (scan)              -> distance to the detected object / obstacle avoidance
    * odometry + TF output from DiffDrive   (odom)
-->
<sdf version="1.9">
  <model name="search_robot">
    <pose>0 0 0 0 0 0</pose>

    <!-- ================= body ================= -->
    <link name="base_link">
      <pose>0 0 0.07 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0107</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0161</iyy><iyz>0</iyz>
          <izz>0.0246</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><box><size>0.30 0.24 0.08</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><box><size>0.30 0.24 0.08</size></box></geometry>
        <material>
          <ambient>0.10 0.35 0.80 1</ambient>
          <diffuse>0.10 0.35 0.80 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <!-- top plate (bright so the robot is easy to spot from the overhead camera) -->
      <visual name="top_plate_visual">
        <pose>-0.02 0 0.045 0 0 0</pose>
        <geometry><box><size>0.24 0.22 0.01</size></box></geometry>
        <material>
          <ambient>1.0 0.75 0.05 1</ambient>
          <diffuse>1.0 0.75 0.05 1</diffuse>
        </material>
      </visual>
      <!-- heading arrow on the top plate -->
      <visual name="heading_visual">
        <pose>0.06 0 0.052 0 0 0</pose>
        <geometry><box><size>0.10 0.03 0.005</size></box></geometry>
        <material>
          <ambient>0.9 0.1 0.1 1</ambient>
          <diffuse>0.9 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- camera housing + sensor -->
      <visual name="camera_visual">
        <pose>0.15 0 0.07 0 0 0</pose>
        <geometry><box><size>0.03 0.08 0.04</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name="front_camera" type="camera">
        <pose>0.17 0 0.07 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>camera/image_raw</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.3</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>40</far>
          </clip>
        </camera>
      </sensor>

      <!-- LiDAR (mounted above the camera so the housing does not block the beams) -->
      <visual name="lidar_mast_visual">
        <pose>-0.02 0 0.08 0 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.08</length></cylinder></geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="lidar_visual">
        <pose>-0.02 0 0.13 0 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.03</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <pose>-0.02 0 0.13 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <!-- ================= wheels ================= -->
    <link name="wheel_left_link">
      <pose>0.0 0.14 0.05 -1.5708 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.00014</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00014</iyy><iyz>0</iyz>
          <izz>0.00025</izz>
        </inertia>
      </inertial>
      <collision name="wheel_left_collision">
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
      </collision>
      <visual name="wheel_left_visual">
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="wheel_right_link">
      <pose>0.0 -0.14 0.05 -1.5708 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.00014</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00014</iyy><iyz>0</iyz>
          <izz>0.00025</izz>
        </inertia>
      </inertial>
      <collision name="wheel_right_collision">
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
      </collision>
      <visual name="wheel_right_visual">
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_left_link</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_right_link</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- ================= caster (frictionless sphere) ================= -->
    <link name="caster_link">
      <pose>-0.11 0 0.025 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0000125</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0000125</iyy><iyz>0</iyz>
          <izz>0.0000125</izz>
        </inertia>
      </inertial>
      <collision name="caster_collision">
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <surface>
          <friction>
            <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="caster_visual">
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_link</child>
    </joint>

    <!-- front caster: keeps the body (and the LiDAR plane) level when braking -->
    <link name="front_caster_link">
      <pose>0.11 0 0.025 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0000125</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0000125</iyy><iyz>0</iyz>
          <izz>0.0000125</izz>
        </inertia>
      </inertial>
      <collision name="front_caster_collision">
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <surface>
          <friction>
            <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="front_caster_visual">
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="front_caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_caster_link</child>
    </joint>

    <!-- ================= plugins ================= -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.28</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>
    <!-- ground-truth pose in the world frame (stands in for SLAM/AMCL localisation) -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>search_robot</robot_base_frame>
      <odom_topic>/ground_truth</odom_topic>
      <tf_topic>/ground_truth/tf</tf_topic>
      <dimensions>2</dimensions>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
