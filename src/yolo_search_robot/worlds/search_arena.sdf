<?xml version="1.0"?>
<!--
  Search arena: 10 m x 10 m room split into four areas by partition walls.

        y
        ^   NW: chair               NE: person
        |   ==== P2 ====         ==== P3 ====
        |
        |   SW: start   P1    SE: fire hydrant
        |               ||
        +==============================  x

  The fire hydrant and the chair are hidden from the start position so the robot has to
  explore. The person is visible from several places: it is not a target of the first mission
  (so the robot must ignore it), but YOLO detections are remembered, so when the user later
  asks for "人" the robot can go straight to it. The suitcase is an obstacle / distractor.
  Object models: Gazebo Fuel (OpenRobotics), downloaded automatically on first launch.
-->
<sdf version="1.9">
  <world name="search_arena">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.75 0.82 0.90 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- ===================== floor ===================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- coloured floor per area (visual only) -->
    <model name="floor_tiles">
      <static>true</static>
      <link name="link">
        <visual name="sw">
          <pose>-2.25 -1.75 0.002 0 0 0</pose>
          <geometry><box><size>5.5 6.5 0.002</size></box></geometry>
          <material><ambient>0.80 0.78 0.70 1</ambient><diffuse>0.80 0.78 0.70 1</diffuse></material>
        </visual>
        <visual name="se">
          <pose>2.75 -2.0 0.002 0 0 0</pose>
          <geometry><box><size>4.5 6.0 0.002</size></box></geometry>
          <material><ambient>0.70 0.80 0.74 1</ambient><diffuse>0.70 0.80 0.74 1</diffuse></material>
        </visual>
        <visual name="nw">
          <pose>-2.25 3.25 0.002 0 0 0</pose>
          <geometry><box><size>5.5 3.5 0.002</size></box></geometry>
          <material><ambient>0.72 0.74 0.85 1</ambient><diffuse>0.72 0.74 0.85 1</diffuse></material>
        </visual>
        <visual name="ne">
          <pose>2.75 3.0 0.002 0 0 0</pose>
          <geometry><box><size>4.5 4.0 0.002</size></box></geometry>
          <material><ambient>0.85 0.74 0.74 1</ambient><diffuse>0.85 0.74 0.74 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== walls ===================== -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <!-- outer walls -->
        <collision name="north_c"><pose>0 5 0.6 0 0 0</pose><geometry><box><size>10.15 0.15 1.2</size></box></geometry></collision>
        <visual name="north_v"><pose>0 5 0.6 0 0 0</pose><geometry><box><size>10.15 0.15 1.2</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <collision name="south_c"><pose>0 -5 0.6 0 0 0</pose><geometry><box><size>10.15 0.15 1.2</size></box></geometry></collision>
        <visual name="south_v"><pose>0 -5 0.6 0 0 0</pose><geometry><box><size>10.15 0.15 1.2</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <collision name="east_c"><pose>5 0 0.6 0 0 0</pose><geometry><box><size>0.15 10.15 1.2</size></box></geometry></collision>
        <visual name="east_v"><pose>5 0 0.6 0 0 0</pose><geometry><box><size>0.15 10.15 1.2</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <collision name="west_c"><pose>-5 0 0.6 0 0 0</pose><geometry><box><size>0.15 10.15 1.2</size></box></geometry></collision>
        <visual name="west_v"><pose>-5 0 0.6 0 0 0</pose><geometry><box><size>0.15 10.15 1.2</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>

        <!-- P1: separates SW (start) and SE, x = 0.5, y in [-5, -1] -->
        <collision name="p1_c"><pose>0.5 -3.0 0.6 0 0 0</pose><geometry><box><size>0.15 4.0 1.2</size></box></geometry></collision>
        <visual name="p1_v"><pose>0.5 -3.0 0.6 0 0 0</pose><geometry><box><size>0.15 4.0 1.2</size></box></geometry>
          <material><ambient>0.55 0.35 0.25 1</ambient><diffuse>0.55 0.35 0.25 1</diffuse></material></visual>
        <!-- P2: separates NW, y = 1.5, x in [-5, -1.5] -->
        <collision name="p2_c"><pose>-3.25 1.5 0.6 0 0 0</pose><geometry><box><size>3.5 0.15 1.2</size></box></geometry></collision>
        <visual name="p2_v"><pose>-3.25 1.5 0.6 0 0 0</pose><geometry><box><size>3.5 0.15 1.2</size></box></geometry>
          <material><ambient>0.55 0.35 0.25 1</ambient><diffuse>0.55 0.35 0.25 1</diffuse></material></visual>
        <!-- P3: separates NE, y = 1.0, x in [2, 5] -->
        <collision name="p3_c"><pose>3.5 1.0 0.6 0 0 0</pose><geometry><box><size>3.0 0.15 1.2</size></box></geometry></collision>
        <visual name="p3_v"><pose>3.5 1.0 0.6 0 0 0</pose><geometry><box><size>3.0 0.15 1.2</size></box></geometry>
          <material><ambient>0.55 0.35 0.25 1</ambient><diffuse>0.55 0.35 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ===================== search targets ===================== -->
    <include>
      <name>fire_hydrant</name>
      <pose>3.2 -3.6 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Fire hydrant</uri>
    </include>
    <include>
      <name>chair</name>
      <pose>-3.6 3.6 0 0 0 -0.8</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Chair</uri>
    </include>
    <include>
      <name>person</name>
      <pose>3.6 3.6 0 0 0 -2.4</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person</uri>
    </include>

    <!-- ===================== obstacle / distractor ===================== -->
    <include>
      <name>suitcase</name>
      <pose>-1.2 -0.6 0 0 0 0.5</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Suitcase1</uri>
    </include>

    <!-- ===================== robot ===================== -->
    <include>
      <name>search_robot</name>
      <pose>-3.5 -3.5 0.01 0 0 0</pose>
      <uri>model://search_robot</uri>
    </include>

    <!-- ===================== overhead camera (for the demo video only) ===================== -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0 0 12 0 1.5708 1.5708</pose>
      <link name="link">
        <sensor name="overhead" type="camera">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <visualize>false</visualize>
          <topic>overhead/image_raw</topic>
          <camera>
            <horizontal_fov>0.9</horizontal_fov>
            <image>
              <width>720</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>1.0</near>
              <far>30</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
